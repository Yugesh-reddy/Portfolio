{
  "name": "yugesh-portfolio",
  "description": "Personal portfolio and blog of Yugesh Reddy Sappidi.",
  "repository": "https://github.com/Yugesh-reddy/yugesh-portfolio",
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": {
      "description": "Public site URL (e.g. https://your-app.herokuapp.com)",
      "required": true
    },
    "GITHUB_CONTRIBUTIONS_API_URL": {
      "description": "GitHub contributions API base URL",
      "value": "https://github-contributions-api.jogruber.de",
      "required": false
    },
    "HUSKY": {
      "description": "Disable git hooks on Heroku",
      "value": "0",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
