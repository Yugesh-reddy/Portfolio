NEXT_PUBLIC_APP_URL=http://localhost:3000

# https://github.com/grubersjoe/github-contributions-api
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de

# Server-only Gemini API key for Evee: https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Optional live Spotify tile. See docs/spotify-setup.md.
# Server-only credentials; never use a NEXT_PUBLIC_ prefix.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional Apple Watch rings. See docs/activity-setup.md.
# All three values stay on the server. Use a random token of at least 32 characters.
ACTIVITY_SYNC_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
